# Modelo do arquivo api/.env.production (copie e preencha; NUNCA versione o arquivo real).
APP_NAME=MediaHub
APP_ENV=production            # "staging" enquanto o pagamento for simulado
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://seu-dominio.com.br
FRONTEND_URL=https://seu-dominio.com.br
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mediahub
DB_USERNAME=mediahub
DB_PASSWORD=                  # senha forte
DB_ROOT_PASSWORD=             # senha forte (usada pelo MySQL do compose)

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit             # troque pelo SMTP real em produção
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@seu-dominio.com.br
MAIL_FROM_NAME=MediaHub

SANCTUM_TOKEN_DAYS=7
SEED_DEMO_DATA=false

MARKETPLACE_COMMISSION_BPS=2000
MARKETPLACE_AUTO_APPROVE=false

# Pagamento: "simulated" (somente staging/testes) ou "asaas" (produção real)
PAYMENT_GATEWAY=simulated
PAYMENT_SIMULATED_ENVS=local,testing,staging
PAYMENT_SIMULATED_SECRET=     # segredo longo e aleatório

# Disco de mídia: "media" (local) ou "r2" (Cloudflare R2, veja docs/deploy.md)
MEDIA_DISK=media

# --- Pagamentos reais (Asaas) ---
# PAYMENT_GATEWAY=asaas
# ASAAS_URL=https://api.asaas.com/v3          # sandbox: https://api-sandbox.asaas.com/v3
# ASAAS_KEY=
# ASAAS_WEBHOOK_TOKEN=                         # o mesmo token configurado no webhook do painel Asaas (cabeçalho asaas-access-token)

# --- Armazenamento em Cloudflare R2 (opcional; padrão = disco local) ---
# MEDIA_DISK=r2
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
